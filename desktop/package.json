		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
